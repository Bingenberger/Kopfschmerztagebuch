<?xml version="1.0" encoding="utf-8"?>
<!-- Gesundheitsdaten bleiben auf dem Gerät: keine Cloud-Sicherung. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <!-- Umzug auf ein neues Handy per Kabel/WLAN-Direktübertragung bleibt möglich. -->
</data-extraction-rules>
